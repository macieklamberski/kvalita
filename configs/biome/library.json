{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "root": false,
  "plugins": [],
  "overrides": [
    {
      "includes": ["src/**"],
      "plugins": ["./node_modules/kvalita/configs/biome/plugins/useExportedReturnType.grit"],
      "linter": {
        "rules": {
          "nursery": {
            "noProcessExit": "error"
          },
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["src/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "plugins": [
        "./node_modules/kvalita/configs/biome/plugins/noKeyInObject.grit",
        "./node_modules/kvalita/configs/biome/plugins/noRecordLookup.grit"
      ]
    }
  ]
}
