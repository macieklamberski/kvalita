{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "root": false,
  "plugins": [
    "./node_modules/kvalita/configs/biome/no-coalesced-ternary.grit",
    "./node_modules/kvalita/configs/biome/no-double-cast.grit",
    "./node_modules/kvalita/configs/biome/no-expected-alias.grit",
    "./node_modules/kvalita/configs/biome/no-expected-boolean.grit",
    "./node_modules/kvalita/configs/biome/no-filter-type-predicate.grit",
    "./node_modules/kvalita/configs/biome/no-flatmap-ternary.grit",
    "./node_modules/kvalita/configs/biome/no-guarded-assign.grit",
    "./node_modules/kvalita/configs/biome/no-inline-each-table.grit",
    "./node_modules/kvalita/configs/biome/no-literal-equality-chain.grit",
    "./node_modules/kvalita/configs/biome/no-nested-call.grit",
    "./node_modules/kvalita/configs/biome/no-object-cast.grit",
    "./node_modules/kvalita/configs/biome/no-promise-catch.grit",
    "./node_modules/kvalita/configs/biome/no-screaming-const.grit",
    "./node_modules/kvalita/configs/biome/no-short-name.grit",
    "./node_modules/kvalita/configs/biome/use-if-guard.grit",
    "./node_modules/kvalita/configs/biome/use-nullish-type.grit",
    "./node_modules/kvalita/configs/biome/use-regex-suffix.grit",
    "./node_modules/kvalita/configs/biome/use-should-title.grit",
    "./node_modules/kvalita/configs/biome/use-throwing-const.grit",
    "./node_modules/kvalita/configs/biome/use-to-be-undefined.grit"
  ],
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "plugins": [
        "./node_modules/kvalita/configs/biome/no-await-expect-rejects.grit",
        "./node_modules/kvalita/configs/biome/no-dense-expect-chain.grit",
        "./node_modules/kvalita/configs/biome/no-empty-todo.grit",
        "./node_modules/kvalita/configs/biome/no-not-to-have-property.grit",
        "./node_modules/kvalita/configs/biome/no-numbered-variant.grit",
        "./node_modules/kvalita/configs/biome/no-own-module-mock.grit",
        "./node_modules/kvalita/configs/biome/no-placeholder-data.grit",
        "./node_modules/kvalita/configs/biome/no-resolve-helper.grit",
        "./node_modules/kvalita/configs/biome/no-return-assertion.grit",
        "./node_modules/kvalita/configs/biome/no-snapshot.grit",
        "./node_modules/kvalita/configs/biome/no-undefined-in-expected.grit",
        "./node_modules/kvalita/configs/biome/use-block-fixture.grit",
        "./node_modules/kvalita/configs/biome/use-to-be-for-primitives.grit",
        "./node_modules/kvalita/configs/biome/use-to-equal-for-objects.grit",
        "./node_modules/kvalita/configs/biome/use-to-equal-over-to-match-object.grit",
        "./node_modules/kvalita/configs/biome/use-value-name.grit"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useExpectToContain": "error"
          },
          "suspicious": {
            "noExportsInTest": "error"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "formatWithErrors": true,
    "lineWidth": 100,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single"
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "formatter": {
      "enabled": true,
      "selfCloseVoidElements": "always",
      "indentScriptAndStyle": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedAttributes": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "noAmbiguousAnchorText": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noDefaultExport": "error",
        "noDoneCallback": "error",
        "noEnum": "error",
        "noImplicitBoolean": "error",
        "noInferrableTypes": "error",
        "noMultiAssign": "error",
        "noMultilineString": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noProcessEnv": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useAtIndex": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "generic"
          }
        },
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentEnumValueType": "error",
        "useConsistentMethodSignatures": "error",
        "useConsistentTestIt": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useDefaultParameterLast": "error",
        "useErrorCause": "error",
        "useForOf": "error",
        "useFragmentSyntax": "error",
        "useGlobalThis": "error",
        "useNumberNamespace": "error",
        "useObjectSpread": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useTemplate": "error",
        "useTestHooksOnTop": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error"
      },
      "complexity": {
        "noExcessiveNestedCallbacks": "error",
        "noExcessiveNestedTestSuites": "error",
        "noForEach": "error",
        "noRedundantDefaultExport": "error",
        "noUselessCatchBinding": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefined": "error",
        "useArrayFind": "error",
        "useArrowFunction": "error"
      },
      "correctness": {
        "noReactPropAssignments": "error",
        "noUnusedInstantiation": "error",
        "useImportExtensions": "error",
        "useJsonImportAttributes": "error"
      },
      "suspicious": {
        "noConditionalExpect": "error",
        "noDuplicatedSpreadProps": "error",
        "noEmptySource": "error",
        "noFocusedTests": "error",
        "noForIn": "error",
        "noIdenticalTestTitle": "error",
        "noImportCycles": "error",
        "noMisplacedAssertion": "error",
        "noNestedPromises": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noProto": "error",
        "noReturnAssign": "error",
        "noSkippedTests": "error",
        "noVar": "error",
        "useArraySortCompare": "error",
        "useAwait": "error",
        "useErrorMessage": "error"
      },
      "performance": {
        "noDelete": "error",
        "noSyncScripts": "error",
        "useTopLevelRegex": "error"
      },
      "security": {
        "noScriptUrl": "error"
      },
      "nursery": {
        "noBaseToString": "error",
        "noDanglingUnderscore": "error",
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": {
            "style": "expression"
          }
        },
        "useIncludes": "error",
        "useNullishCoalescing": {
          "level": "error",
          "options": {
            "ignoreIfStatements": true
          }
        },
        "useRegexpExec": "error",
        "useValidTestTitle": "error"
      }
    }
  }
}
