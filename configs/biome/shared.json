{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "root": false,
  "plugins": [
    "./node_modules/kvalita/configs/biome/plugins/noArrayConcat.grit",
    "./node_modules/kvalita/configs/biome/plugins/noCoalescedTernary.grit",
    "./node_modules/kvalita/configs/biome/plugins/noDoubleCast.grit",
    "./node_modules/kvalita/configs/biome/plugins/noEmptyStringTest.grit",
    "./node_modules/kvalita/configs/biome/plugins/noExpectedAlias.grit",
    "./node_modules/kvalita/configs/biome/plugins/noExpectedBoolean.grit",
    "./node_modules/kvalita/configs/biome/plugins/noFilterTypePredicate.grit",
    "./node_modules/kvalita/configs/biome/plugins/noFlatmapTernary.grit",
    "./node_modules/kvalita/configs/biome/plugins/noGuardedAssign.grit",
    "./node_modules/kvalita/configs/biome/plugins/noInlineEachTable.grit",
    "./node_modules/kvalita/configs/biome/plugins/noLiteralEqualityChain.grit",
    "./node_modules/kvalita/configs/biome/plugins/noObjectCast.grit",
    "./node_modules/kvalita/configs/biome/plugins/noPromiseCatch.grit",
    "./node_modules/kvalita/configs/biome/plugins/noReturnNull.grit",
    "./node_modules/kvalita/configs/biome/plugins/noScreamingConst.grit",
    "./node_modules/kvalita/configs/biome/plugins/noShortName.grit",
    "./node_modules/kvalita/configs/biome/plugins/noThen.grit",
    "./node_modules/kvalita/configs/biome/plugins/noTypeofUndefined.grit",
    "./node_modules/kvalita/configs/biome/plugins/noWrappedImplicitReturn.grit",
    "./node_modules/kvalita/configs/biome/plugins/useErrorCatchName.grit",
    "./node_modules/kvalita/configs/biome/plugins/useIfGuard.grit",
    "./node_modules/kvalita/configs/biome/plugins/useIfOverTernaryGuard.grit",
    "./node_modules/kvalita/configs/biome/plugins/useNamedFunctionType.grit",
    "./node_modules/kvalita/configs/biome/plugins/usePredicateReturnsBoolean.grit",
    "./node_modules/kvalita/configs/biome/plugins/useRecordType.grit",
    "./node_modules/kvalita/configs/biome/plugins/useRegexSuffix.grit",
    "./node_modules/kvalita/configs/biome/plugins/useShouldTitle.grit",
    "./node_modules/kvalita/configs/biome/plugins/useThrowingConst.grit",
    "./node_modules/kvalita/configs/biome/plugins/useToBeUndefined.grit",
    "./node_modules/kvalita/configs/biome/plugins/noInlineGlobalRegex.grit"
  ],
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "plugins": [
        "./node_modules/kvalita/configs/biome/plugins/noAwaitExpectRejects.grit",
        "./node_modules/kvalita/configs/biome/plugins/noComputedExpected.grit",
        "./node_modules/kvalita/configs/biome/plugins/noDenseExpectChain.grit",
        "./node_modules/kvalita/configs/biome/plugins/noEmptyTodo.grit",
        "./node_modules/kvalita/configs/biome/plugins/noExpectResolves.grit",
        "./node_modules/kvalita/configs/biome/plugins/noInlineHtmlTag.grit",
        "./node_modules/kvalita/configs/biome/plugins/noInlineTestObject.grit",
        "./node_modules/kvalita/configs/biome/plugins/noLabelTuple.grit",
        "./node_modules/kvalita/configs/biome/plugins/noNotToHaveProperty.grit",
        "./node_modules/kvalita/configs/biome/plugins/noNumberedVariant.grit",
        "./node_modules/kvalita/configs/biome/plugins/noOwnModuleMock.grit",
        "./node_modules/kvalita/configs/biome/plugins/noPlaceholderData.grit",
        "./node_modules/kvalita/configs/biome/plugins/noResolveHelper.grit",
        "./node_modules/kvalita/configs/biome/plugins/noReturnAssertion.grit",
        "./node_modules/kvalita/configs/biome/plugins/noSnapshot.grit",
        "./node_modules/kvalita/configs/biome/plugins/noToStrictEqual.grit",
        "./node_modules/kvalita/configs/biome/plugins/noTopLevelTest.grit",
        "./node_modules/kvalita/configs/biome/plugins/noTruthyMatcher.grit",
        "./node_modules/kvalita/configs/biome/plugins/noUndefinedInExpected.grit",
        "./node_modules/kvalita/configs/biome/plugins/noWrappedExpectSubject.grit",
        "./node_modules/kvalita/configs/biome/plugins/useBlockFixture.grit",
        "./node_modules/kvalita/configs/biome/plugins/useEachPlaceholder.grit",
        "./node_modules/kvalita/configs/biome/plugins/useExpectInTest.grit",
        "./node_modules/kvalita/configs/biome/plugins/useToBeForPrimitives.grit",
        "./node_modules/kvalita/configs/biome/plugins/useToEqualForObjects.grit",
        "./node_modules/kvalita/configs/biome/plugins/useValueBeforeExpected.grit",
        "./node_modules/kvalita/configs/biome/plugins/useValueName.grit"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useExpectToContain": "error"
          },
          "suspicious": {
            "noDuplicateTestHooks": "error",
            "noExportsInTest": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.ts", "**/*.tsx", "!**/*.test.ts", "!**/*.test.tsx"],
      "plugins": [
        "./node_modules/kvalita/configs/biome/plugins/noKeyInObject.grit",
        "./node_modules/kvalita/configs/biome/plugins/useTopLevelLiteralList.grit",
        "./node_modules/kvalita/configs/biome/plugins/useTypedEmptyCollection.grit"
      ]
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "formatWithErrors": true,
    "lineWidth": 100,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single"
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "formatter": {
      "enabled": true,
      "selfCloseVoidElements": "always",
      "indentScriptAndStyle": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedAttributes": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "noAmbiguousAnchorText": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noDoneCallback": "error",
        "noEnum": "error",
        "noImplicitBoolean": "error",
        "noInferrableTypes": "error",
        "noMultiAssign": "error",
        "noMultilineString": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noProcessEnv": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useAtIndex": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "generic"
          }
        },
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentEnumValueType": "error",
        "useConsistentMethodSignatures": "error",
        "useConsistentObjectDefinitions": "error",
        "useConsistentTestIt": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useDefaultParameterLast": "error",
        "useErrorCause": "error",
        "useForOf": "error",
        "useFragmentSyntax": "error",
        "useGlobalThis": "error",
        "useImportsFirst": "error",
        "useNumberNamespace": "error",
        "useObjectSpread": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useTemplate": "error",
        "useTestHooksOnTop": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error"
      },
      "complexity": {
        "noExcessiveNestedCallbacks": "error",
        "noExcessiveNestedTestSuites": "error",
        "noForEach": "error",
        "noRedundantDefaultExport": "error",
        "noUselessCatchBinding": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefined": "error",
        "useArrayFind": "error",
        "useArraySome": "error",
        "useArrowFunction": "error",
        "useRegexpTest": "error"
      },
      "correctness": {
        "noGlobalDirnameFilename": "error",
        "noReactPropAssignments": "error",
        "noUnusedInstantiation": "error",
        "useJsonImportAttributes": "error",
        "useParseIntRadix": "error"
      },
      "suspicious": {
        "noConditionalExpect": "error",
        "noDuplicatedSpreadProps": "error",
        "noEmptySource": "error",
        "noFocusedTests": "error",
        "noForIn": "error",
        "noIdenticalTestTitle": "error",
        "noMisplacedAssertion": "error",
        "noNestedPromises": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noProto": "error",
        "noReturnAssign": "error",
        "noSkippedTests": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useArraySortCompare": "error",
        "useAwait": "error",
        "useErrorMessage": "error"
      },
      "performance": {
        "noDelete": "error",
        "noSyncScripts": "error",
        "useTopLevelRegex": "error"
      },
      "security": {
        "noScriptUrl": "error"
      },
      "nursery": {
        "noBaseToString": "error",
        "noDanglingUnderscore": "error",
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "off",
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": {
            "style": "expression"
          }
        },
        "useExhaustiveSwitchCases": "error",
        "useIncludes": "error",
        "useNullishCoalescing": {
          "level": "error",
          "options": {
            "ignoreIfStatements": true
          }
        },
        "useRegexpExec": "error",
        "useStringStartsEndsWith": "error",
        "useValidTestTitle": "error"
      }
    }
  }
}
