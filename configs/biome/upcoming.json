{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "root": false,
  "plugins": ["./node_modules/kvalita/configs/biome/plugins/noDeprecatedTrousseName.grit"],
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "plugins": []
    },
    {
      "includes": ["**", "!**/*.test.ts", "!**/*.test.tsx"],
      "plugins": [
        "./node_modules/kvalita/configs/biome/plugins/useDecodeBase64.grit",
        "./node_modules/kvalita/configs/biome/plugins/noTrousseNameShadow.grit",
        "./node_modules/kvalita/configs/biome/plugins/useIsNonEmptyString.grit",
        "./node_modules/kvalita/configs/biome/plugins/useGetOrigin.grit",
        "./node_modules/kvalita/configs/biome/plugins/useOmit.grit",
        "./node_modules/kvalita/configs/biome/plugins/useTrimString.grit",
        "./node_modules/kvalita/configs/biome/plugins/useTrimObjectOptions.grit"
      ]
    }
  ]
}
