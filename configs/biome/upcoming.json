{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "root": false,
  "plugins": [],
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "plugins": []
    },
    {
      "includes": ["**", "!**/*.test.ts", "!**/*.test.tsx"],
      "plugins": [
        "./node_modules/kvalita/configs/biome/plugins/noBareNewUrl.grit",
        "./node_modules/kvalita/configs/biome/plugins/useTypeofGuard.grit",
        "./node_modules/kvalita/configs/biome/plugins/useNullishGuard.grit",
        "./node_modules/kvalita/configs/biome/plugins/useIsValidDate.grit"
      ]
    }
  ]
}
