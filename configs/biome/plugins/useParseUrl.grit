language js

// A bare `new URL` throws on bad input, so every parse goes through parseUrl, the guarded `try`
// around one included.
or {
  `URL.parse($...)`,
  `new URL($_)`,
  `new URL($_, $_)`
} as $parse where {
  register_diagnostic(span=$parse, message="Parse with parseUrl from trousse, which returns undefined for bad input instead of throwing or returning null, then guard for undefined: parseUrl(value) or parseUrl(value, base).")
}
