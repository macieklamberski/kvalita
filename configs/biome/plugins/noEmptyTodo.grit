language js

`$todo($title, $callback)` as $call where {
  $todo <: or {
    `it.todo`,
    `test.todo`,
    `describe.todo`
  },
  $callback <: JsArrowFunctionExpression(body=$body),
  $body <: r"^\{\s*\}$",
  register_diagnostic(span=$call, message="Describe the scenario in a comment inside the `.todo` body.")
}
