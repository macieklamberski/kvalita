language js

JsNewExpression(callee=`Set`, arguments=$arguments) as $set where {
  $arguments <: JsCallArguments(args=[JsArrayExpression(elements=$elements)]),
  $elements <: not [],
  $elements <: not some not or {
    JsStringLiteralExpression(),
    JsNumberLiteralExpression()
  },
  register_diagnostic(span=$set, message="A literal membership list is a plain array checked with `.includes()`; a Set is for a large or runtime-built collection.")
}
