language js

// omitEmpty drops nullish and empty-string items, and gives undefined where none is left, so a
// list checked for having no item but empty ones, or filtered of empty strings, is its job.
// filter(Boolean) also drops 0 and false, so it is left alone.
or {
  `$list.every(($item) => !$item)`,
  `$list.filter(($item) => $item !== '')`,
  `$list.filter(($item) => isPresent($item) && $item !== '')`,
  `$list.filter(($item) => $item !== undefined && $item !== '')`,
  `$list.filter(($item) => $item != null && $item !== '')`
} as $check where {
  register_diagnostic(span=$check, message="Drop empty items with omitEmpty from trousse, which gives undefined when none is left: omitEmpty(list).")
}
