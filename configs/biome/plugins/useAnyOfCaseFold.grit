language js

// Covers the case-folded comparisons useAnyOf.grit misses: a literal Set, an optional chain, a
// some callback and an anchored case-insensitive alternation. A compare of two folded values
// belongs to useIsSameText.
or {
  `$set.has($value.toLowerCase())` where {
    $program <: contains `const $set = new Set($items)` where { $items <: JsArrayExpression() }
  },
  `$set.has($value?.toLowerCase())` where {
    $program <: contains `const $set = new Set($items)` where { $items <: JsArrayExpression() }
  },
  `$value?.toLowerCase() === $literal` where { $literal <: string() },
  `$value?.toLowerCase() !== $literal` where { $literal <: string() },
  `$literal === $value?.toLowerCase()` where { $literal <: string() },
  `$literal !== $value?.toLowerCase()` where { $literal <: string() },
  `$list.some(($item) => $item === $value.toLowerCase())`,
  `$list.some($callback)` where {
    $callback <: JsArrowFunctionExpression(body=JsFunctionBody(statements=[
      JsReturnStatement(argument=`$item === $value.toLowerCase()`)
    ]))
  },
  `$regex.test($value)` where { $regex <: r"/\^\((?:\?:)?[\w|-]+\)\$/i" }
} as $compare where {
  not $value <: r"(?s).*\b(?:tagName|nodeName|localName)$",
  register_diagnostic(span=$compare, message="Match the value with isAnyOf from trousse, which folds case and trims: isAnyOf(value, ['embed', 'watch']).")
}
