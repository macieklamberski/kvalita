language js

or {
  or {
    `Array.isArray($value) ? $value : [$value]`,
    `!Array.isArray($value) ? [$value] : $value`,
    `Array.isArray($value) ? $value[0] : $value`,
    `!Array.isArray($value) ? $value : $value[0]`,
    `$array.flat()` where { $array <: JsArrayExpression(elements=[$value]) }
  } as $test where {
    register_diagnostic(span=$test, message="Coerce with coerceArray or coerceSingular from trousse: coerceArray(value).")
  },
  // A falsy fallback with || is not the same, since coerceArray wraps '', 0 and false.
  `coerceArray($_ ?? $empty)` as $test where {
    $empty <: JsArrayExpression(elements=[]),
    register_diagnostic(span=$test, message="Pass the value to coerceArray from trousse as is, since it returns [] for null and undefined: coerceArray(value).")
  }
}
