language js

// A local binding named like a trousse export is a hand-rolled copy of the helper, whatever shape
// its body takes. An exported one is a project's own public api, such as feedcanon's re-exports,
// while a local inside an exported function is still a copy.
// The short locale helpers t and tx are left out, since a one-letter name says nothing.
or {
  JsVariableDeclarator(id=$name),
  JsFunctionDeclaration(id=$name)
} as $declaration where {
  $name <: or {
    `addMissingProtocol`,
    `addMissingScheme`,
    `anyWordMatchesAnyOf`,
    `archiveExtensions`,
    `audioExtensions`,
    `codeExtensions`,
    `coerceArray`,
    `coerceBoolean`,
    `coerceDate`,
    `coerceNumber`,
    `coerceSingular`,
    `coerceString`,
    `composeFragment`,
    `composeQuery`,
    `createAcceptHeader`,
    `createUrlSpellings`,
    `createUrlVariants`,
    `decodeBase64`,
    `decodeBase64Binary`,
    `decodeBase64Url`,
    `decodeBase64UrlBinary`,
    `decodePercent`,
    `decodeSegment`,
    `documentExtensions`,
    `encodePathSegment`,
    `endsWithAnyOf`,
    `escapeHtml`,
    `escapeRegex`,
    `feedExtensions`,
    `feedMimeTypes`,
    `fixMalformedHost`,
    `fixMalformedProtocol`,
    `fixMalformedQuery`,
    `fixMalformedScheme`,
    `flashExtensions`,
    `fontExtensions`,
    `genericFeedMimeTypes`,
    `genericHtmlMimeTypes`,
    `getAnyOf`,
    `getFragmentParam`,
    `getFragmentParamValues`,
    `getFragmentParams`,
    `getOrigin`,
    `getPathSegments`,
    `getQueryParam`,
    `getQueryParamValues`,
    `getQueryParams`,
    `getRegistrableDomain`,
    `getSubdomain`,
    `hasFragmentParam`,
    `hasQueryParam`,
    `htmlMimeTypes`,
    `imageExtensions`,
    `includesAnyOf`,
    `installerExtensions`,
    `isAnyOf`,
    `isBoolean`,
    `isBrandDomainOf`,
    `isFiniteNumber`,
    `isFunction`,
    `isHostOf`,
    `isHostOrSubdomainOf`,
    `isHostname`,
    `isHttpUrl`,
    `isInteger`,
    `isIpAddress`,
    `isJsonLike`,
    `isLocale`,
    `isLocaleOrRegion`,
    `isLocaleSegment`,
    `isLooseMatch`,
    `isNonEmptyString`,
    `isNullish`,
    `isNumber`,
    `isObject`,
    `isParseableJson`,
    `isPlainObject`,
    `isPresent`,
    `isRegion`,
    `isRegionSegment`,
    `isSameText`,
    `isString`,
    `isSubdomainOf`,
    `isUtf8Binary`,
    `isValidDate`,
    `normalizeUrl`,
    `omit`,
    `omitEmpty`,
    `pageExtensions`,
    `parseJson`,
    `parseUrl`,
    `pick`,
    `resolveFeedProtocol`,
    `resolveFeedScheme`,
    `resolveUrl`,
    `sleep`,
    `startsWithAnyOf`,
    `stripWww`,
    `subtitleExtensions`,
    `toMap`,
    `trimArray`,
    `trimObject`,
    `trimString`,
    `trimUrlValues`,
    `upgradeProtocol`,
    `upgradeScheme`,
    `videoExtensions`,
    `webAudioExtensions`,
    `webImageExtensions`,
    `webVideoExtensions`
  },
  not and { $declaration <: within JsExport(), not $declaration <: within JsFunctionBody() },
  register_diagnostic(span=$name, message="Import the trousse helper of the same name instead of keeping a local copy, or rename the local value if it does another job.")
}
