language js

// A value folded into a binding only to compare it with literals is isAnyOf, as the inline compare
// useAnyOf flags is: `const page = script.toLowerCase()` then `page === 'opac-search'`. A binding
// with any other use, a lookup key or a returned value, holds the folded value on purpose.
JsFunctionBody() as $body where {
  $body <: contains or {
    `const $name = $value.toLowerCase()`,
    `const $name = $value?.toLowerCase()`,
    `const $name = $value.toUpperCase()`,
    `const $name = $value?.toUpperCase()`
  } as $binding,
  not $body <: contains JsIdentifierExpression() as $use where {
    $use <: `$name`,
    not $use <: within or {
      `$name === $literal` where { $literal <: string() },
      `$name !== $literal` where { $literal <: string() },
      `$literal === $name` where { $literal <: string() },
      `$literal !== $name` where { $literal <: string() }
    }
  },
  $body <: contains JsIdentifierExpression() as $first where { $first <: `$name` },
  register_diagnostic(span=$binding, message="Match the value as written with isAnyOf from trousse, which folds case and trims, in place of folding it into a binding only to compare it: isAnyOf(script, 'opac-search').")
}
