language js

// The trousse matchers fold case themselves, so a value or a pattern folded before one of them is
// folded twice. A binding folded only to feed them belongs to useAnyOfFoldedBinding.
or {
  or {
    `isAnyOf($value.toLowerCase(), $patterns)`,
    `isAnyOf($value?.toLowerCase(), $patterns)`,
    `isAnyOf($value.toUpperCase(), $patterns)`,
    `isAnyOf($value?.toUpperCase(), $patterns)`,
    `isAnyOf($value.toLocaleLowerCase(), $patterns)`,
    `isAnyOf($value?.toLocaleLowerCase(), $patterns)`,
    `isAnyOf($value.toLocaleUpperCase(), $patterns)`,
    `isAnyOf($value?.toLocaleUpperCase(), $patterns)`,
    `getAnyOf($value.toLowerCase(), $patterns)`,
    `getAnyOf($value?.toLowerCase(), $patterns)`,
    `getAnyOf($value.toUpperCase(), $patterns)`,
    `getAnyOf($value?.toUpperCase(), $patterns)`,
    `getAnyOf($value.toLocaleLowerCase(), $patterns)`,
    `getAnyOf($value?.toLocaleLowerCase(), $patterns)`,
    `getAnyOf($value.toLocaleUpperCase(), $patterns)`,
    `getAnyOf($value?.toLocaleUpperCase(), $patterns)`,
    `includesAnyOf($value.toLowerCase(), $patterns)`,
    `includesAnyOf($value?.toLowerCase(), $patterns)`,
    `includesAnyOf($value.toUpperCase(), $patterns)`,
    `includesAnyOf($value?.toUpperCase(), $patterns)`,
    `includesAnyOf($value.toLocaleLowerCase(), $patterns)`,
    `includesAnyOf($value?.toLocaleLowerCase(), $patterns)`,
    `includesAnyOf($value.toLocaleUpperCase(), $patterns)`,
    `includesAnyOf($value?.toLocaleUpperCase(), $patterns)`,
    `startsWithAnyOf($value.toLowerCase(), $patterns)`,
    `startsWithAnyOf($value?.toLowerCase(), $patterns)`,
    `startsWithAnyOf($value.toUpperCase(), $patterns)`,
    `startsWithAnyOf($value?.toUpperCase(), $patterns)`,
    `startsWithAnyOf($value.toLocaleLowerCase(), $patterns)`,
    `startsWithAnyOf($value?.toLocaleLowerCase(), $patterns)`,
    `startsWithAnyOf($value.toLocaleUpperCase(), $patterns)`,
    `startsWithAnyOf($value?.toLocaleUpperCase(), $patterns)`,
    `endsWithAnyOf($value.toLowerCase(), $patterns)`,
    `endsWithAnyOf($value?.toLowerCase(), $patterns)`,
    `endsWithAnyOf($value.toUpperCase(), $patterns)`,
    `endsWithAnyOf($value?.toUpperCase(), $patterns)`,
    `endsWithAnyOf($value.toLocaleLowerCase(), $patterns)`,
    `endsWithAnyOf($value?.toLocaleLowerCase(), $patterns)`,
    `endsWithAnyOf($value.toLocaleUpperCase(), $patterns)`,
    `endsWithAnyOf($value?.toLocaleUpperCase(), $patterns)`,
    `anyWordMatchesAnyOf($value.toLowerCase(), $patterns)`,
    `anyWordMatchesAnyOf($value?.toLowerCase(), $patterns)`,
    `anyWordMatchesAnyOf($value.toUpperCase(), $patterns)`,
    `anyWordMatchesAnyOf($value?.toUpperCase(), $patterns)`,
    `anyWordMatchesAnyOf($value.toLocaleLowerCase(), $patterns)`,
    `anyWordMatchesAnyOf($value?.toLocaleLowerCase(), $patterns)`,
    `anyWordMatchesAnyOf($value.toLocaleUpperCase(), $patterns)`,
    `anyWordMatchesAnyOf($value?.toLocaleUpperCase(), $patterns)`,
    `isSameText($value.toLowerCase(), $other)`,
    `isSameText($value?.toLowerCase(), $other)`,
    `isSameText($value.toUpperCase(), $other)`,
    `isSameText($value?.toUpperCase(), $other)`,
    `isSameText($value.toLocaleLowerCase(), $other)`,
    `isSameText($value?.toLocaleLowerCase(), $other)`,
    `isSameText($value.toLocaleUpperCase(), $other)`,
    `isSameText($value?.toLocaleUpperCase(), $other)`,
    `isSameText($other, $value.toLowerCase())`,
    `isSameText($other, $value?.toLowerCase())`,
    `isSameText($other, $value.toUpperCase())`,
    `isSameText($other, $value?.toUpperCase())`,
    `isSameText($other, $value.toLocaleLowerCase())`,
    `isSameText($other, $value?.toLocaleLowerCase())`,
    `isSameText($other, $value.toLocaleUpperCase())`,
    `isSameText($other, $value?.toLocaleUpperCase())`,
    `isAnyOf($value, $pattern.toLowerCase())`,
    `isAnyOf($value, $pattern?.toLowerCase())`,
    `isAnyOf($value, $pattern.toUpperCase())`,
    `isAnyOf($value, $pattern?.toUpperCase())`,
    `isAnyOf($value, $pattern.toLocaleLowerCase())`,
    `isAnyOf($value, $pattern?.toLocaleLowerCase())`,
    `isAnyOf($value, $pattern.toLocaleUpperCase())`,
    `isAnyOf($value, $pattern?.toLocaleUpperCase())`,
    `getAnyOf($value, $pattern.toLowerCase())`,
    `getAnyOf($value, $pattern?.toLowerCase())`,
    `getAnyOf($value, $pattern.toUpperCase())`,
    `getAnyOf($value, $pattern?.toUpperCase())`,
    `getAnyOf($value, $pattern.toLocaleLowerCase())`,
    `getAnyOf($value, $pattern?.toLocaleLowerCase())`,
    `getAnyOf($value, $pattern.toLocaleUpperCase())`,
    `getAnyOf($value, $pattern?.toLocaleUpperCase())`,
    `includesAnyOf($value, $pattern.toLowerCase())`,
    `includesAnyOf($value, $pattern?.toLowerCase())`,
    `includesAnyOf($value, $pattern.toUpperCase())`,
    `includesAnyOf($value, $pattern?.toUpperCase())`,
    `includesAnyOf($value, $pattern.toLocaleLowerCase())`,
    `includesAnyOf($value, $pattern?.toLocaleLowerCase())`,
    `includesAnyOf($value, $pattern.toLocaleUpperCase())`,
    `includesAnyOf($value, $pattern?.toLocaleUpperCase())`,
    `startsWithAnyOf($value, $pattern.toLowerCase())`,
    `startsWithAnyOf($value, $pattern?.toLowerCase())`,
    `startsWithAnyOf($value, $pattern.toUpperCase())`,
    `startsWithAnyOf($value, $pattern?.toUpperCase())`,
    `startsWithAnyOf($value, $pattern.toLocaleLowerCase())`,
    `startsWithAnyOf($value, $pattern?.toLocaleLowerCase())`,
    `startsWithAnyOf($value, $pattern.toLocaleUpperCase())`,
    `startsWithAnyOf($value, $pattern?.toLocaleUpperCase())`,
    `endsWithAnyOf($value, $pattern.toLowerCase())`,
    `endsWithAnyOf($value, $pattern?.toLowerCase())`,
    `endsWithAnyOf($value, $pattern.toUpperCase())`,
    `endsWithAnyOf($value, $pattern?.toUpperCase())`,
    `endsWithAnyOf($value, $pattern.toLocaleLowerCase())`,
    `endsWithAnyOf($value, $pattern?.toLocaleLowerCase())`,
    `endsWithAnyOf($value, $pattern.toLocaleUpperCase())`,
    `endsWithAnyOf($value, $pattern?.toLocaleUpperCase())`,
    `isAnyOf($value, $list.map(($item) => $item.toLowerCase()))`,
    `isAnyOf($value, $list.map(($item) => $item.toUpperCase()))`,
    `isAnyOf($value, $list.map(($item) => $item.toLocaleLowerCase()))`,
    `isAnyOf($value, $list.map(($item) => $item.toLocaleUpperCase()))`,
    `getAnyOf($value, $list.map(($item) => $item.toLowerCase()))`,
    `getAnyOf($value, $list.map(($item) => $item.toUpperCase()))`,
    `getAnyOf($value, $list.map(($item) => $item.toLocaleLowerCase()))`,
    `getAnyOf($value, $list.map(($item) => $item.toLocaleUpperCase()))`,
    `includesAnyOf($value, $list.map(($item) => $item.toLowerCase()))`,
    `includesAnyOf($value, $list.map(($item) => $item.toUpperCase()))`,
    `includesAnyOf($value, $list.map(($item) => $item.toLocaleLowerCase()))`,
    `includesAnyOf($value, $list.map(($item) => $item.toLocaleUpperCase()))`,
    `startsWithAnyOf($value, $list.map(($item) => $item.toLowerCase()))`,
    `startsWithAnyOf($value, $list.map(($item) => $item.toUpperCase()))`,
    `startsWithAnyOf($value, $list.map(($item) => $item.toLocaleLowerCase()))`,
    `startsWithAnyOf($value, $list.map(($item) => $item.toLocaleUpperCase()))`,
    `endsWithAnyOf($value, $list.map(($item) => $item.toLowerCase()))`,
    `endsWithAnyOf($value, $list.map(($item) => $item.toUpperCase()))`,
    `endsWithAnyOf($value, $list.map(($item) => $item.toLocaleLowerCase()))`,
    `endsWithAnyOf($value, $list.map(($item) => $item.toLocaleUpperCase()))`,
    `anyWordMatchesAnyOf($value, $list.map(($item) => $item.toLowerCase()))`,
    `anyWordMatchesAnyOf($value, $list.map(($item) => $item.toUpperCase()))`,
    `anyWordMatchesAnyOf($value, $list.map(($item) => $item.toLocaleLowerCase()))`,
    `anyWordMatchesAnyOf($value, $list.map(($item) => $item.toLocaleUpperCase()))`
  } as $call where {
    not $value <: r"(?s).*\b(?:tagName|nodeName|localName)$",
    register_diagnostic(span=$call, message="Pass the value and the patterns as written: the trousse matchers fold case themselves, as in includesAnyOf(href, uris).")
  },
  or {
    `isAnyOf($value, $patterns)`,
    `getAnyOf($value, $patterns)`,
    `includesAnyOf($value, $patterns)`,
    `startsWithAnyOf($value, $patterns)`,
    `endsWithAnyOf($value, $patterns)`,
    `anyWordMatchesAnyOf($value, $patterns)`
  } as $call where {
    $patterns <: JsArrayExpression(),
    $patterns <: contains or {
      `$item.toLowerCase()`,
      `$item.toUpperCase()`,
      `$item.toLocaleLowerCase()`,
      `$item.toLocaleUpperCase()`,
      `$item?.toLowerCase()`,
      `$item?.toUpperCase()`,
      `$item?.toLocaleLowerCase()`,
      `$item?.toLocaleUpperCase()`
    },
    not $value <: r"(?s).*\b(?:tagName|nodeName|localName)$",
    register_diagnostic(span=$call, message="Pass the value and the patterns as written: the trousse matchers fold case themselves, as in includesAnyOf(href, uris).")
  }
}
