language js

or {
  `$value != null`,
  `$value == null`,
  `$value != undefined`,
  `$value == undefined`,
  `null != $value`,
  `null == $value`,
  `$value !== null && $value !== undefined`,
  `$value !== undefined && $value !== null`,
  `$value === null || $value === undefined`,
  `$value === undefined || $value === null`
} as $compare where {
  register_diagnostic(span=$compare, message="Test for null and undefined with isPresent or isNullish from trousse, and on a generic value guard with !isPresent(value), since isNullish does not narrow T: isPresent(value).")
}
