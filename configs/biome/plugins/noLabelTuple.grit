language js

`$each($table)($title, $callback)` where {
  $each <: or {
    `it.each`,
    `test.each`,
    `describe.each`
  },
  $table <: not JsCallExpression(),
  $callback <: JsArrowFunctionExpression(parameters=$parameters),
  $parameters <: r"^\(\s*_\w*\s*,.*",
  register_diagnostic(span=$parameters, message="Drop the column the callback ignores: keep the row label as a comment beside its row.")
}
