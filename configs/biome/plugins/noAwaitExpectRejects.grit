language js

JsFunctionBody(statements=$statements) where {
  $statements <: [..., $last],
  $last <: JsExpressionStatement(expression=`await expect($value).rejects.$matcher($args)`),
  register_diagnostic(span=$last, message="Drop the await: nothing after this `expect(...).rejects` assertion needs it settled, and Bun fails it when the promise resolves. A test with no other await then drops `async` too.")
}
