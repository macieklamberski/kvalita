language js

// A template counts when an interpolation follows a query or fragment name and `=`, so a path
// template or a fixed query stays out.
or {
  JsTemplateExpression() as $query where {
    $query <: r"(?s)`[^`]*[?&#][A-Za-z_][\w.\[\]-]*=\$\{.*"
  },
  `new URLSearchParams($_).toString()` as $query,
  `new URLSearchParams($_)` as $query where {
    $query <: within JsTemplateExpression(),
    not $query <: within `new URLSearchParams($_).toString()`
  }
} as $query where {
  register_diagnostic(span=$query, message="Build the query with composeQuery or composeFragment from trousse instead of a hand-written template or a URLSearchParams: composeQuery({ v: id }).")
}
